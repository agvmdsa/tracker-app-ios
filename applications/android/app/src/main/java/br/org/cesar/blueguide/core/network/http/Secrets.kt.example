package br.org.cesar.blueguide.core.network.http

/**
 * Template for `Secrets.kt`, which is gitignored (holds the real API key, never committed).
 *
 * To set up: copy this file to `Secrets.kt` (same folder, drop the `.example`), and replace the
 * value below with whatever is set as the `API_KEY` environment variable on the Render API
 * service — it must match exactly, it's a single shared secret, not per-device auth. See
 * `applications/api/README.md`'s "Authentication" section.
 */
object Secrets {
    const val API_KEY = "REPLACE_WITH_THE_RENDER_API_KEY_VALUE"
}
