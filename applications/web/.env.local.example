# Base URL of the TrackerApp Positioning API (FastAPI). Must be reachable from the browser:
# the dashboard opens an EventSource to ${NEXT_PUBLIC_API_BASE_URL}/fixes/stream.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# How often (ms) the dashboard polls GET /health for the liveness badge. Positions are NOT
# polled — the API pushes each new fix over Server-Sent Events as the phones POST it.
NEXT_PUBLIC_POLL_INTERVAL_MS=1000