# Base URL of the TrackerApp Positioning API (FastAPI).
# Local docker compose default:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# How often (ms) the dashboard polls the API for fresh positions.
# 1s matches the map's glide animation for smooth real-time tracking.
NEXT_PUBLIC_POLL_INTERVAL_MS=1000

# Mock mode: when "true" the dashboard generates fake data client-side and
# never calls the API. Useful because the API currently exposes NO GET read
# endpoints yet (only /health, POST /sightings, POST /fixes) — see README.
# Set to "false" once the read endpoints below exist on the backend.
NEXT_PUBLIC_USE_MOCK=true
